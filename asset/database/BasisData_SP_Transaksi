-- 8.1 CREATE Booking
CREATE PROCEDURE SP_Booking_Insert
    @ID_Customer        INT,
    @ID_Karyawan        INT,
    @ID_Jadwal          INT,
    @ID_Promo           INT = NULL,
    @Tanggal_Booking    DATE,
    @Metode_Pembayaran  VARCHAR(20),
    @Total_Bayar        DECIMAL(18,2),
    @Created_By         VARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Customer WHERE ID_Customer = @ID_Customer AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Customer tidak ditemukan!', 16, 1);
        RETURN;
    END
    
    IF NOT EXISTS (SELECT 1 FROM Karyawan WHERE ID_Karyawan = @ID_Karyawan AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Karyawan tidak ditemukan!', 16, 1);
        RETURN;
    END
    
    IF NOT EXISTS (SELECT 1 FROM Jadwal WHERE ID_Jadwal = @ID_Jadwal AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Jadwal tidak ditemukan!', 16, 1);
        RETURN;
    END
    
    IF @ID_Promo IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Promo WHERE ID_Promo = @ID_Promo AND Is_Deleted = 0 AND Status = 1)
    BEGIN
        RAISERROR('Promo tidak valid atau tidak aktif!', 16, 1);
        RETURN;
    END
    
    -- Cek apakah jadwal sudah dibooking (status <> 3 = dibatalkan)
    IF EXISTS (SELECT 1 FROM Booking WHERE ID_Jadwal = @ID_Jadwal AND Status <> 3)
    BEGIN
        RAISERROR('Jadwal sudah dibooking!', 16, 1);
        RETURN;
    END

    INSERT INTO Booking 
    (ID_Customer, ID_Karyawan, ID_Jadwal, ID_Promo, Tanggal_Booking, 
     Metode_Pembayaran, Total_Bayar, Status, Created_By, Created_Date)
    VALUES 
    (@ID_Customer, @ID_Karyawan, @ID_Jadwal, @ID_Promo, @Tanggal_Booking,
     @Metode_Pembayaran, @Total_Bayar, 0, @Created_By, GETDATE());
END
GO

-- 8.2 READ Booking
CREATE PROCEDURE SP_Booking_Select
    @ID_Booking   INT = NULL,
    @ID_Customer  INT = NULL,
    @Status       INT = NULL
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT b.ID_Booking, b.ID_Customer, c.Nama_Customer, 
           b.ID_Karyawan, k.Nama_Karyawan,
           b.ID_Jadwal, j.Tanggal AS Tanggal_Main, j.Jam_Mulai, j.Jam_Selesai,
           l.Nama_Lapangan, l.Harga_Sewa,
           b.ID_Promo, p.Nama_Promo, p.Diskon,
           b.Tanggal_Booking, b.Metode_Pembayaran, b.Total_Bayar, b.Status,
           b.Created_By, b.Created_Date, b.Modified_By, b.Modified_Date
    FROM Booking b
    JOIN Customer c ON b.ID_Customer = c.ID_Customer
    JOIN Karyawan k ON b.ID_Karyawan = k.ID_Karyawan
    JOIN Jadwal j ON b.ID_Jadwal = j.ID_Jadwal
    JOIN Lapangan l ON j.ID_Lapangan = l.ID_Lapangan
    LEFT JOIN Promo p ON b.ID_Promo = p.ID_Promo
    WHERE (@ID_Booking IS NULL OR b.ID_Booking = @ID_Booking)
      AND (@ID_Customer IS NULL OR b.ID_Customer = @ID_Customer)
      AND (@Status IS NULL OR b.Status = @Status)
      AND c.Is_Deleted = 0 AND k.Is_Deleted = 0
    ORDER BY b.Created_Date DESC;
END
GO

-- 8.3 UPDATE Booking (Update status, promo, dll)
CREATE PROCEDURE SP_Booking_Update
    @ID_Booking         INT,
    @ID_Promo           INT = NULL,
    @Metode_Pembayaran  VARCHAR(20) = NULL,
    @Total_Bayar        DECIMAL(18,2) = NULL,
    @Status             INT = NULL,
    @Modified_By        VARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Booking WHERE ID_Booking = @ID_Booking)
    BEGIN
        RAISERROR('Data Booking tidak ditemukan!', 16, 1);
        RETURN;
    END

    IF @ID_Promo IS NOT NULL AND NOT EXISTS (SELECT 1 FROM Promo WHERE ID_Promo = @ID_Promo AND Is_Deleted = 0 AND Status = 1)
    BEGIN
        RAISERROR('Promo tidak valid atau tidak aktif!', 16, 1);
        RETURN;
    END

    UPDATE Booking
    SET ID_Promo          = COALESCE(@ID_Promo, ID_Promo),
        Metode_Pembayaran = COALESCE(@Metode_Pembayaran, Metode_Pembayaran),
        Total_Bayar       = COALESCE(@Total_Bayar, Total_Bayar),
        Status            = COALESCE(@Status, Status),
        Modified_By       = @Modified_By,
        Modified_Date     = GETDATE()
    WHERE ID_Booking = @ID_Booking;
END
GO

-- 8.4 DELETE Booking (Soft Delete / Batalkan)
CREATE PROCEDURE SP_Booking_Cancel
    @ID_Booking  INT,
    @ID_Karyawan INT,        -- Karyawan yang membatalkan
    @Alasan      VARCHAR(255),
    @Modified_By VARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Booking WHERE ID_Booking = @ID_Booking AND Status <> 3)
    BEGIN
        RAISERROR('Data Booking tidak ditemukan atau sudah dibatalkan!', 16, 1);
        RETURN;
    END

    DECLARE @Total DECIMAL(18,2) = (SELECT Total_Bayar FROM Booking WHERE ID_Booking = @ID_Booking);
    DECLARE @BiayaBatal DECIMAL(18,2) = @Total * 0.5;
    DECLARE @Refund DECIMAL(18,2) = @Total * 0.5;

    -- Update status booking jadi dibatalkan
    UPDATE Booking
    SET Status = 3,
        Modified_By = @Modified_By,
        Modified_Date = GETDATE()
    WHERE ID_Booking = @ID_Booking;

    -- Insert ke tabel pembatalan
    INSERT INTO Pembatalan_Booking
    (ID_Booking, ID_Karyawan, Tanggal_Batal, Alasan, Biaya_Batal, Nominal_Refund, Metode_Refund, Status, Created_By, Created_Date)
    VALUES
    (@ID_Booking, @ID_Karyawan, GETDATE(), @Alasan, @BiayaBatal, @Refund, 'QRIS', 1, @Modified_By, GETDATE());
END
GO


