-- 10.1 CREATE Beli Alat (dengan detail)
CREATE PROCEDURE SP_BeliAlat_Insert
    @ID_Karyawan        INT,
    @ID_Customer        INT,
    @Tanggal_Beli       DATE,
    @Metode_Pembayaran  VARCHAR(20),
    @Created_By         VARCHAR(50),
    -- Detail beli (XML/JSON string untuk multiple items)
    @DetailItems        NVARCHAR(MAX)  -- Format: [{"id_alat":1,"jumlah":2},...]
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Karyawan WHERE ID_Karyawan = @ID_Karyawan AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Karyawan tidak ditemukan!', 16, 1);
        RETURN;
    END
    
    IF NOT EXISTS (SELECT 1 FROM Customer WHERE ID_Customer = @ID_Customer AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Customer tidak ditemukan!', 16, 1);
        RETURN;
    END

    BEGIN TRANSACTION;
    
    BEGIN TRY
        -- Insert header
        INSERT INTO Beli_Alat 
        (ID_Karyawan, ID_Customer, Tanggal_Beli, Metode_Pembayaran, Total_Bayar, Status, Created_By, Created_Date)
        VALUES 
        (@ID_Karyawan, @ID_Customer, @Tanggal_Beli, @Metode_Pembayaran, 0, 0, @Created_By, GETDATE());
        
        DECLARE @ID_Beli INT = SCOPE_IDENTITY();
        DECLARE @TotalBayar DECIMAL(18,2) = 0;
        
        -- Parse JSON detail items
        DECLARE @id_alat INT, @jumlah INT, @harga DECIMAL(18,2), @subtotal DECIMAL(18,2);
        
        DECLARE item_cursor CURSOR FOR
        SELECT JSON_VALUE(j.value, '$.id_alat') AS id_alat,
               JSON_VALUE(j.value, '$.jumlah') AS jumlah
        FROM OPENJSON(@DetailItems) AS j;
        
        OPEN item_cursor;
        FETCH NEXT FROM item_cursor INTO @id_alat, @jumlah;
        
        WHILE @@FETCH_STATUS = 0
        BEGIN
            SET @harga = (SELECT Harga_Alat FROM Alat WHERE ID_Alat = @id_alat AND Is_Deleted = 0);
            
            IF @harga IS NULL
            BEGIN
                RAISERROR('Alat tidak ditemukan!', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END
            
            IF @jumlah <= 0
            BEGIN
                RAISERROR('Jumlah harus lebih dari 0!', 16, 1);
                ROLLBACK TRANSACTION;
                RETURN;
            END
            
            SET @subtotal = @harga * @jumlah;
            SET @TotalBayar = @TotalBayar + @subtotal;
            
            INSERT INTO Detail_Beli_Alat (ID_Alat, ID_Beli, Jumlah, SubTotal)
            VALUES (@id_alat, @ID_Beli, @jumlah, @subtotal);
            
            FETCH NEXT FROM item_cursor INTO @id_alat, @jumlah;
        END
        
        CLOSE item_cursor;
        DEALLOCATE item_cursor;
        
        -- Update total bayar
        UPDATE Beli_Alat
        SET Total_Bayar = @TotalBayar
        WHERE ID_Beli = @ID_Beli;
        
        COMMIT TRANSACTION;
    END TRY
    BEGIN CATCH
        IF @@TRANCOUNT > 0 ROLLBACK TRANSACTION;
        THROW;
    END CATCH
END
GO

-- 10.2 READ Beli Alat
CREATE PROCEDURE SP_BeliAlat_Select
    @ID_Beli     INT = NULL,
    @ID_Customer INT = NULL,
    @Status      INT = NULL
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT ba.ID_Beli, ba.ID_Customer, c.Nama_Customer,
           ba.ID_Karyawan, k.Nama_Karyawan,
           ba.Tanggal_Beli, ba.Metode_Pembayaran, ba.Total_Bayar, ba.Status,
           ba.Created_By, ba.Created_Date, ba.Modified_By, ba.Modified_Date
    FROM Beli_Alat ba
    JOIN Customer c ON ba.ID_Customer = c.ID_Customer
    JOIN Karyawan k ON ba.ID_Karyawan = k.ID_Karyawan
    WHERE (@ID_Beli IS NULL OR ba.ID_Beli = @ID_Beli)
      AND (@ID_Customer IS NULL OR ba.ID_Customer = @ID_Customer)
      AND (@Status IS NULL OR ba.Status = @Status)
      AND c.Is_Deleted = 0 AND k.Is_Deleted = 0
    ORDER BY ba.Created_Date DESC;
END
GO

-- 10.3 READ Detail Beli Alat
CREATE PROCEDURE SP_BeliAlat_Detail_Select
    @ID_Beli INT
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT d.ID_Alat, a.Nama_Alat, a.Harga_Alat, d.Jumlah, d.SubTotal
    FROM Detail_Beli_Alat d
    JOIN Alat a ON d.ID_Alat = a.ID_Alat
    WHERE d.ID_Beli = @ID_Beli;
END
GO

-- 10.4 UPDATE Beli Alat (Update status pembayaran)
CREATE PROCEDURE SP_BeliAlat_UpdateStatus
    @ID_Beli     INT,
    @Status      INT,
    @Modified_By VARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Beli_Alat WHERE ID_Beli = @ID_Beli)
    BEGIN
        RAISERROR('Data Beli Alat tidak ditemukan!', 16, 1);
        RETURN;
    END

    UPDATE Beli_Alat
    SET Status        = @Status,
        Modified_By   = @Modified_By,
        Modified_Date = GETDATE()
    WHERE ID_Beli = @ID_Beli;
END
GO