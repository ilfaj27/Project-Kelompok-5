-- 9.1 CREATE Langganan
CREATE PROCEDURE SP_Langganan_Insert
    @ID_Customer        INT,
    @ID_Karyawan        INT,
    @ID_Tipe            INT,
    @Tanggal_Mulai      DATE,
    @Tanggal_Selesai    DATE,
    @Total_Bayar        DECIMAL(18,2),
    @Metode_Pembayaran  VARCHAR(20),
    @Created_By         VARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Customer WHERE ID_Customer = @ID_Customer AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Customer tidak ditemukan!', 16, 1);
        RETURN;
    END
    
    IF NOT EXISTS (SELECT 1 FROM Karyawan WHERE ID_Karyawan = @ID_Karyawan AND Is_Deleted = 0)
    BEGIN
        RAISERROR('Karyawan tidak ditemukan!', 16, 1);
        RETURN;
    END
    
    IF NOT EXISTS (SELECT 1 FROM Tipe_Member WHERE ID_Tipe = @ID_Tipe AND Is_Deleted = 0 AND Status = 1)
    BEGIN
        RAISERROR('Tipe Member tidak valid atau tidak aktif!', 16, 1);
        RETURN;
    END
    
    IF @Tanggal_Mulai > @Tanggal_Selesai
    BEGIN
        RAISERROR('Tanggal mulai tidak boleh lebih besar dari tanggal selesai!', 16, 1);
        RETURN;
    END

    INSERT INTO Langganan 
    (ID_Customer, ID_Karyawan, ID_Tipe, Tanggal_Mulai, Tanggal_Selesai,
     Total_Bayar, Metode_Pembayaran, Status, Created_By, Created_Date)
    VALUES 
    (@ID_Customer, @ID_Karyawan, @ID_Tipe, @Tanggal_Mulai, @Tanggal_Selesai,
     @Total_Bayar, @Metode_Pembayaran, 0, @Created_By, GETDATE());
END
GO

-- 9.2 READ Langganan
CREATE PROCEDURE SP_Langganan_Select
    @ID_Langganan INT = NULL,
    @ID_Customer  INT = NULL,
    @Status       INT = NULL
AS
BEGIN
    SET NOCOUNT ON;
    
    SELECT l.ID_Langganan, l.ID_Customer, c.Nama_Customer,
           l.ID_Karyawan, k.Nama_Karyawan,
           l.ID_Tipe, tm.Nama_Tipe, tm.Harga_Member, tm.Potongan_Harga,
           l.Tanggal_Mulai, l.Tanggal_Selesai,
           l.Total_Bayar, l.Metode_Pembayaran, l.Status,
           l.Created_By, l.Created_Date, l.Modified_By, l.Modified_Date
    FROM Langganan l
    JOIN Customer c ON l.ID_Customer = c.ID_Customer
    JOIN Karyawan k ON l.ID_Karyawan = k.ID_Karyawan
    JOIN Tipe_Member tm ON l.ID_Tipe = tm.ID_Tipe
    WHERE (@ID_Langganan IS NULL OR l.ID_Langganan = @ID_Langganan)
      AND (@ID_Customer IS NULL OR l.ID_Customer = @ID_Customer)
      AND (@Status IS NULL OR l.Status = @Status)
      AND c.Is_Deleted = 0 AND k.Is_Deleted = 0 AND tm.Is_Deleted = 0
    ORDER BY l.Created_Date DESC;
END
GO

-- 9.3 UPDATE Langganan (Update status)
CREATE PROCEDURE SP_Langganan_Update
    @ID_Langganan       INT,
    @Tanggal_Mulai      DATE = NULL,
    @Tanggal_Selesai    DATE = NULL,
    @Total_Bayar        DECIMAL(18,2) = NULL,
    @Metode_Pembayaran  VARCHAR(20) = NULL,
    @Status             INT = NULL,
    @Modified_By        VARCHAR(50)
AS
BEGIN
    SET NOCOUNT ON;
    
    IF NOT EXISTS (SELECT 1 FROM Langganan WHERE ID_Langganan = @ID_Langganan)
    BEGIN
        RAISERROR('Data Langganan tidak ditemukan!', 16, 1);
        RETURN;
    END

    IF @Tanggal_Mulai IS NOT NULL AND @Tanggal_Selesai IS NOT NULL
       AND @Tanggal_Mulai > @Tanggal_Selesai
    BEGIN
        RAISERROR('Tanggal mulai tidak boleh lebih besar dari tanggal selesai!', 16, 1);
        RETURN;
    END

    UPDATE Langganan
    SET Tanggal_Mulai     = COALESCE(@Tanggal_Mulai, Tanggal_Mulai),
        Tanggal_Selesai   = COALESCE(@Tanggal_Selesai, Tanggal_Selesai),
        Total_Bayar       = COALESCE(@Total_Bayar, Total_Bayar),
        Metode_Pembayaran = COALESCE(@Metode_Pembayaran, Metode_Pembayaran),
        Status            = COALESCE(@Status, Status),
        Modified_By       = @Modified_By,
        Modified_Date     = GETDATE()
    WHERE ID_Langganan = @ID_Langganan;
END
GO


